   "definitions": {
    "vol": "residue volume in solution, A^3, Zamyatnin 1972 Prog Biophys Mol Biol 24:107-123 (values checked against the GPM tabulation of that table)",
    "kd": "Kyte-Doolittle hydropathy, J Mol Biol 157:105-132 (1982) (values checked against ExPASy ProtScale)",
    "charge": "formal side-chain charge near pH 7: Asp -1, Glu -1, Lys +1, Arg +1, all others 0 (His 0 by convention)",
    "blosum62": "NCBI BLOSUM62 file, data/BLOSUM62.txt (sha256 pinned)",
    "d*": "mutant minus wild type"
   }
  },
  "L": {
   "cols": [
    "L_min_heavy_dist_A",
    "L_min_sidechain_dist_A",
    "L_n_contact_atoms_4p5",
    "L_ca_min_dist_A"
   ],
   "definitions": {
    "L_min_heavy_dist_A": "minimum distance, A, between any heavy atom of the wild-type residue and any heavy atom of the ligand",
    "L_min_sidechain_dist_A": "minimum distance, A, between side-chain heavy atoms (CB onward) and ligand heavy atoms; missing with reason no_side_chain for glycine",
    "L_n_contact_atoms_4p5": "number of heavy atoms of the wild-type residue within 4.5 A of any ligand heavy atom",
    "L_ca_min_dist_A": "distance, A, from the C\u03b1 to the nearest ligand heavy atom"
   }
  },
  "T": {
   "cols": [
    "kappa_v1..kappa_v7",
    "tau_sin_h1..tau_sin_h6",
    "tau_cos_h1..tau_cos_h6"
   ],
   "definitions": {
    "kappa": "turning angle, radians in [0, pi], at the seven interior vertices of the nine-C\u03b1 window (core compute_ca_features; checked against the numpy reference within 1e-4)",
    "tau": "signed torsion between consecutive osculating planes at the six hinges, represented as sin and cos (circular quantity); bond lengths are not included"
   }
  },
  "C": {
   "cols": [
    "d_i_j for 0<=i<j<=8"
   ],
   "definitions": {
    "d_i_j": "Euclidean distance, A, between window C\u03b1 i and j (36 values) from exactly the nine coordinates used by T"
   }
  },
